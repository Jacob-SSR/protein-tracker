# ---- Database (Supabase PostgreSQL) ----
# Runtime: ผ่าน pooler (PgBouncer) port 6543
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrate/introspect เท่านั้น: direct connection port 5432
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.supabase.co:5432/postgres"

# ---- Auth ----
# openssl rand -base64 48
JWT_SECRET="change-me-in-vercel-environment-variables"
JWT_EXPIRES_IN="8h"

# ---- Seed (ใช้ครั้งแรกครั้งเดียว) ----
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_PASSWORD="change-me-now"

# ---- Cloudinary (รูปประกอบบทความ) ----
# หาได้ที่ Dashboard ของ Cloudinary
# ถ้าไม่ตั้ง 3 ตัวนี้ ระบบยังใช้ได้ปกติ แค่ปุ่มอัปโหลดรูปจะขึ้น error ตอนกด
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
# ห้ามใส่ NEXT_PUBLIC_ นำหน้า — ตัวนี้ต้องอยู่ฝั่ง server เท่านั้น
CLOUDINARY_API_SECRET="your-api-secret"
